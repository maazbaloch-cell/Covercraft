# =====================================================================
# CoverCraft — environment variables
# Copy this file to `.env` (local) or set these in your host (Vercel →
# Project → Settings → Environment Variables). Never commit real values.
# NEXT_PUBLIC_* are exposed to the browser; everything else is server-only.
# Do NOT set NODE_ENV — the platform provides it.
# =====================================================================

# ============================ DATABASE ===============================
# Supabase Postgres. On an IPv4-only network use Dashboard → Connect → Session pooler.
# REQUIRED. For serverless (Vercel) DATABASE_URL should be the Transaction pooler
# (port 6543) with ?pgbouncer=true; DIRECT_URL is the direct connection (port 5432)
# used only for migrations. Copy each URI exactly from Supabase.
DATABASE_URL="postgresql://postgres.PROJECT_REF:YOUR_DATABASE_PASSWORD@aws-0-YOUR_REGION.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.PROJECT_REF:YOUR_DATABASE_PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres"

# ============================== AUTH =================================
# REQUIRED. JWT_SECRET signs admin + customer session cookies. Must be a long random
# string of at least 32 characters (generate: `openssl rand -base64 48`). The app
# refuses to start auth with a weak/placeholder value — replace this.
JWT_SECRET="YOUR_LONG_RANDOM_SECRET_AT_LEAST_32_CHARS"
# Password for the seeded admin account (used once by `prisma db seed`). At least 12 chars.
ADMIN_INITIAL_PASSWORD="YOUR_STRONG_ADMIN_PASSWORD"

# ========================== APPLICATION ==============================
# REQUIRED in production. Your public site origin (https, no trailing slash).
# Used for the EasyPaisa payment callback, tracking links, and OG/canonical URLs.
# EasyPaisa checkout REJECTS a non-https callback, so this must be a real https URL in prod.
NEXT_PUBLIC_BASE_URL="https://your-domain.com"
# REQUIRED for the reservation-cleanup cron. Protects /api/maintenance/release-reservations;
# Vercel Cron sends it automatically as `Authorization: Bearer $CRON_SECRET`. Long random string.
# (See vercel.json: the */15 schedule needs the Vercel Pro plan; Hobby runs cron at most once/day.)
CRON_SECRET="YOUR_LONG_RANDOM_CRON_SECRET"

# ============================= EMAIL =================================
# Resend. OPTIONAL but strongly recommended — without it, account verification,
# password reset, order/payment confirmation and shipping-update emails are silently
# skipped (the app still works; codes are logged to the server in non-production).
# NOTE: email is enabled only when BOTH RESEND_API_KEY and EMAIL_FROM are set, and
# EMAIL_FROM must be an address on a domain you've verified in Resend.
RESEND_API_KEY="YOUR_RESEND_API_KEY"
EMAIL_FROM="orders@your-domain.com"
# Where admin notifications (new orders, support tickets, monthly report) are sent.
ADMIN_EMAIL="you@your-domain.com"

# ============================ PAYMENT ================================
# EasyPaisa Hosted Checkout (the only payment method). REQUIRED to accept payments.
# Get the Store ID and AES hash key from the EasyPaisa merchant portal.
EASYPAISA_STORE_ID="YOUR_EASYPAISA_STORE_ID"
# AES key — must be exactly 16, 24, or 32 bytes.
EASYPAISA_HASH_KEY="YOUR_EASYPAISA_HASH_KEY_16_24_OR_32_BYTES"
# "sandbox" uses EasyPaisa staging; "production" uses the live endpoint.
EASYPAISA_ENV="sandbox"
# OPTIONAL — set only if EasyPaisa gave your merchant a custom checkout endpoint.
EASYPAISA_CHECKOUT_URL=""
# The payment method enabled for your store, e.g. MA_PAYMENT_METHOD or OTC_PAYMENT_METHOD.
EASYPAISA_PAYMENT_METHOD="MA_PAYMENT_METHOD"

# ============================ SHIPPING ===============================
# Courier live-tracking APIs (TCS, Leopards). OPTIONAL — when a courier's vars are
# empty the tracking page honestly reports "not connected yet" instead of faking scans.
# Request the exact production endpoint + credentials from each courier. Put
# {trackingNumber} in the URL where the consignment number must be inserted.
# *_HEADERS is a JSON object of any extra headers the courier requires.
TCS_TRACKING_API_URL=""
TCS_TRACKING_API_TOKEN=""
TCS_TRACKING_API_HEADERS='{}'
LEOPARDS_TRACKING_API_URL=""
LEOPARDS_TRACKING_API_TOKEN=""
LEOPARDS_TRACKING_API_HEADERS='{}'

# ============================ STORAGE ================================
# Supabase Storage (serverless-safe object storage for admin product images).
# OPTIONAL — without it, admin product image *file uploads* fail (you can still set
# an image by URL). NEXT_PUBLIC_SUPABASE_URL is exposed to the browser; the service
# role key is server-only. The bucket must exist and be public-readable.
NEXT_PUBLIC_SUPABASE_URL="https://PROJECT_REF.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="YOUR_SUPABASE_SERVICE_ROLE_KEY"
SUPABASE_STORAGE_BUCKET="covers"

# ======================== OTHER SERVICES =============================
# WhatsApp (Meta WhatsApp Cloud API) — OPTIONAL customer/admin notifications and
# inbound webhook. When unset, WhatsApp notifications are skipped gracefully.
WHATSAPP_PHONE_NUMBER_ID="YOUR_WHATSAPP_PHONE_NUMBER_ID"
WHATSAPP_ACCESS_TOKEN="YOUR_WHATSAPP_ACCESS_TOKEN"
ADMIN_WHATSAPP_NUMBER="923001234567"
# For the webhook: your chosen verify token + the Meta app secret (validates signatures).
WHATSAPP_VERIFY_TOKEN="YOUR_LONG_RANDOM_VERIFY_TOKEN"
WHATSAPP_APP_SECRET="YOUR_META_APP_SECRET"
