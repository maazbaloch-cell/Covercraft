# ================= DATABASE (Supabase Postgres) =================
# On an IPv4-only network, use Supabase Dashboard -> Connect -> Session pooler.
# Copy its URI exactly. Its host ends in .pooler.supabase.com and uses port 5432.
# For serverless deployments, use the Transaction pooler (port 6543) and add ?pgbouncer=true.
DATABASE_URL="postgresql://postgres.PROJECT_REF:YOUR_DATABASE_PASSWORD@aws-0-YOUR_REGION.pooler.supabase.com:5432/postgres"
DIRECT_URL="postgresql://postgres.PROJECT_REF:YOUR_DATABASE_PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres"

# ================= EASYPAISA (Hosted Checkout) =================
# Obtain the Store ID and AES hash key from the EasyPaisa merchant portal.
EASYPAISA_STORE_ID="your-easypaisa-store-id"
EASYPAISA_HASH_KEY="your-16-24-or-32-byte-easypaisa-hash-key"
# sandbox uses EasyPaisa staging; production uses its live endpoint.
EASYPAISA_ENV="sandbox"
# Optional: use only when EasyPaisa gives your merchant a different checkout endpoint.
EASYPAISA_CHECKOUT_URL=""
# The payment method enabled for your store, e.g. MA_PAYMENT_METHOD or OTC_PAYMENT_METHOD.
EASYPAISA_PAYMENT_METHOD="MA_PAYMENT_METHOD"

# ================= EMAIL (Resend) =================
RESEND_API_KEY="re_your_resend_api_key"
ADMIN_EMAIL="you@example.com"
EMAIL_FROM="onboarding@resend.dev"

# ================= WHATSAPP (Meta WhatsApp Cloud API) =================
WHATSAPP_PHONE_NUMBER_ID="your-phone-number-id"
WHATSAPP_ACCESS_TOKEN="your-whatsapp-access-token"
ADMIN_WHATSAPP_NUMBER="923001234567"
WHATSAPP_VERIFY_TOKEN="choose-a-long-random-string"
WHATSAPP_APP_SECRET="your-meta-app-secret-for-webhook-signature-validation"

# ================= AUTH =================
JWT_SECRET="generate-a-long-random-secret"
ADMIN_INITIAL_PASSWORD="use-a-unique-password-of-at-least-12-characters"

# ================= APP =================
NEXT_PUBLIC_BASE_URL="http://localhost:3000"

# ================= SCHEDULED JOBS (reservation cleanup cron) =================
# Protects /api/maintenance/release-reservations. Vercel Cron sends this as
# `Authorization: Bearer $CRON_SECRET` automatically when the variable is set.
# Use a long random string. See vercel.json for the schedule (Hobby plan runs
# cron at most once/day; the */15 schedule needs the Pro plan).
CRON_SECRET="generate-a-long-random-secret"

# ================= STORAGE (optional for admin product uploads) =================
NEXT_PUBLIC_SUPABASE_URL="https://PROJECT_REF.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-server-only-service-role-key"
SUPABASE_STORAGE_BUCKET="covers"

# ================= COURIER TRACKING =================
# Request the exact production tracking endpoint and credentials from each courier.
# Put {trackingNumber} in the URL where the consignment number must be inserted.
TCS_TRACKING_API_URL=""
TCS_TRACKING_API_TOKEN=""
TCS_TRACKING_API_HEADERS='{}'
LEOPARDS_TRACKING_API_URL=""
LEOPARDS_TRACKING_API_TOKEN=""
LEOPARDS_TRACKING_API_HEADERS='{}'
